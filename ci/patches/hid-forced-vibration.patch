diff --git a/dm/host/hle_hid.c b/dm/host/hle_hid.c
index 5351ff9..6097836 100644
--- a/dm/host/hle_hid.c
+++ b/dm/host/hle_hid.c
@@ -818,6 +818,13 @@ static void vib_send(const uint32_t *handles, const dm_vibration *values, int n)
     dm_haptics_send(updates, count);
 }
 HLE_FORCE("_ZN2nn3hid20IsVibrationPermittedEv", "vibration permission: enabled and an output available", unsigned, h_hid_VibPermit, void) { return dm_haptics_available() != 0; }
+// Horizon's forced-permitted session temporarily overrides its system vibration permission (hid commands 209/210).
+// The host has no Horizon permission layer: output already follows the user's rumble setting, routing and lifecycle.
+// A guest session therefore has no permission to change here, and must not override the host setting or clear motor values.
+// Super Mario Party 1.1.0 ends a session at boot; without this takeover SDK 9.4.0 falls into an unopened hid proxy
+// (sdk build 014256a5d58180219805a7d05fba02e4, +0x3526bc: ldr x8, [x19], x19=0).
+HLE_FORCE("_ZN2nn3hid27BeginForcedVibrationSessionEv", "forced vibration session: host rumble policy remains authoritative", void, h_hid_BeginForcedVib, void) {}
+HLE_FORCE("_ZN2nn3hid25EndForcedVibrationSessionEv", "end forced vibration session: no Horizon permission layer on the host", void, h_hid_EndForcedVib, void) {}
 // Games can cache handles once at startup, before GameController routes the pad's haptics (Unicorn Overlord kept an empty answer and sent every value to handle 0).
 // On Horizon handles are computed from npad id and style (libnx _hidGetVibrationDeviceHandles); vib_send checks for an output at each send. With rumble off they are handed out too,
 // as on a Switch whose vibration setting is off (IsVibrationPermitted answers false and nothing is felt), so turning it on while the game runs works in a game that asked only once.
diff --git a/dm/host/tests/t_hid.c b/dm/host/tests/t_hid.c
index a69a9c9..f74c2d7 100644
--- a/dm/host/tests/t_hid.c
+++ b/dm/host/tests/t_hid.c
@@ -196,8 +196,21 @@ static void t_vibration(void) {
     CHECK(!h_hid_VibPermit(), "disconnecting the last output disables vibration");
     dm_haptics_init(vibration_sink, 0); dm_haptics_route(0, 1);
     CHECK(!h_hid_VibPermit() && h_hid_VibHandles(h, 2, &id, STYLE_HANDHELD) == 2, "rumble disabled: not permitted, but the handles exist, as on a Switch");
+    h_hid_EndForcedVib(); // Super Mario Party's startup sequence ends before any begin.
+    h_hid_BeginForcedVib(); h_hid_SendVib(&h[0], &v);
+    CHECK(!h_hid_VibPermit() && dm_haptics_actual(0, 0).amplitude_low == 0,
+          "a forced guest session cannot override the host's disabled rumble setting");
+    h_hid_EndForcedVib();
     dm_haptics_set_enabled(1);
     CHECK(h_hid_VibPermit(), "rumble turned on while the game runs: the handles it took work");
+    h_hid_SendVib(&h[0], &v);
+    h_hid_BeginForcedVib(); h_hid_EndForcedVib();
+    CHECK(h_hid_VibPermit() && dm_haptics_actual(0, 0).amplitude_low == v.amplitude_low,
+          "ending a guest permission session preserves enabled rumble and the current motor value");
+    dm_haptics_suspend(DM_HAPTICS_INACTIVE, 1);
+    h_hid_BeginForcedVib(); h_hid_SendVib(&h[0], &v); h_hid_EndForcedVib();
+    CHECK(dm_haptics_actual(0, 0).amplitude_low == 0, "guest sessions cannot bypass lifecycle suspension");
+    dm_haptics_suspend(DM_HAPTICS_INACTIVE, 0);
 }
 
 static void *vibration_sender(void *arg) {
